# CloudHive infrastructure

# PostgreSQL
POSTGRES_USER=cloudhive
POSTGRES_PASSWORD=cloudhive
POSTGRES_DB=cloudhive
POSTGRES_PORT=5433

# HDFS
NAMENODE_PORT=9870
NAMENODE_UI_PORT=9870

# Server
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://cloudhive:cloudhive@localhost:5432/cloudhive?schema=public
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# HDFS / WebHDFS
NAMENODE_HOST=localhost
WEBHDFS_PORT=9870
HDFS_BASE_PATH=/cloudhive
