CORE_CONF_fs_defaultFS=hdfs://namenode:8020
CORE_CONF_hadoop_http_staticuser_user=root

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname_check=false
HDFS_CONF_dfs_replication=3
HDFS_CONF_dfs_namenode_http_address=0.0.0.0:9870
HDFS_CONF_dfs_namenode_rpc_address=0.0.0.0:8020

PRE_START_COMMAND=/entrypoint.sh
